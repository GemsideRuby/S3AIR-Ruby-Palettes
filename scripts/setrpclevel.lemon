//# address-hook(0x05a214) end(0x05a214)
function void fn05a214()
{
     if (global.zone_act == 0x1601 || global.zone_act == 0x1701)
        {
            Game.setDiscordState("Brimstone Palace Zone")
            Game.setDiscordLargeImage("https://github.com/GemsideRuby/S3AIR-Ruby-Palettes/blob/main/sprites/discord/Zone_11_RPC.png?raw=true")
            base.fn05a214()
        }
	}

  //# address-hook(0x0572ae) end(0x0572ae)
function void fn0572ae()
{
	if (global.zone == 0x0a)
     {
            Game.setDiscordState("Transcending Sanctuary Zone")
            Game.setDiscordLargeImage("zone_unknown")
            base.fn0572ae()
        }
}  
